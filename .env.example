# Copy to .env and adjust. Everything runs with ZERO keys by default —
# the Anthropic key is only needed for live-mode agent reasoning and the
# real LLM-as-judge guardrail (both have keyless fallbacks).

# ANTHROPIC_API_KEY=

# --- mockops -----------------------------------------------------------
# Seed for deterministic fixtures and fault-injection draws.
MOCKOPS_SEED=42

# Global fault-injection rates (0.0-1.0). Off by default; benchmarks and
# the demo set these per-run via /admin/faults or request headers.
MOCKOPS_FAULTS__RATES__RATE_LIMIT=0.0
MOCKOPS_FAULTS__RATES__TIMEOUT=0.0
MOCKOPS_FAULTS__RATES__MALFORMED=0.0
MOCKOPS_FAULTS__RATES__WRONG_DATA=0.0

# Simulated upstream delay before a TIMEOUT fault responds 504 (seconds).
MOCKOPS_FAULTS__TIMEOUT_DELAY_S=0.05
